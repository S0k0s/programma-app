rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'sokratispoun@gmail.com';
    }
    function isApproved(uid) {
      return exists(/databases/$(database)/documents/access/$(uid)) &&
             get(/databases/$(database)/documents/access/$(uid)).data.status == 'approved';
    }

    // Access records: sign-up is open — a signed-in user creates their own
    // record as 'approved' immediately (no manual admin gate). Only the
    // admin can change status afterwards (e.g. set 'denied' to revoke a
    // specific account), read anyone else's record, or list all records.
    match /access/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid &&
                    request.resource.data.status == 'approved';
      allow update: if isAdmin();
      // A user can delete their own record (part of self-service account
      // deletion); the admin can delete anyone's (moderation cleanup).
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // 'subscription', 'credits', 'onboarding-usage' and the daily
    // 'ai-usage:*' counters are written only by the Cloudflare Worker, via a
    // Firebase service-account credential that bypasses these rules
    // entirely — never by the client. Otherwise a user could just set their
    // own subscription to 'active', top up their own AI Coach credit
    // balance, reset/inflate their own daily quota, or reset their bounded
    // free-onboarding-message counter back to zero, straight from devtools.
    function isServerOnlyDoc(docId) {
      return docId == 'subscription' || docId == 'credits' || docId == 'onboarding-usage' || docId.matches('ai-usage:.*');
    }

    // Per-user app data: locked to the owning uid AND requires an approved
    // access request — except the admin, who can also read/write/delete any
    // user's data directly (needed for the admin panel's "delete account"
    // moderation action, which wipes a target user's data via this same
    // client-side deleteAllUserData() the self-delete flow already uses).
    match /users/{userId}/data/{docId} {
      allow read: if request.auth != null &&
                  ((request.auth.uid == userId && (isAdmin() || isApproved(userId))) || isAdmin());
      // Server-only docs can never be *created or updated* by the client —
      // that's the whole point of isServerOnlyDoc (see above). But deletion
      // is different: it can only remove a doc, never fabricate a fake
      // active/approved value, so it's safe to allow as part of the normal
      // self-delete / admin-delete account cleanup below. Without this
      // split, deleteAllUserData()'s batch delete fails outright (a single
      // rejected op fails the whole batch) for any account that has ever
      // used the AI Coach or subscribed — i.e. almost every real account.
      allow create, update: if request.auth != null && !isServerOnlyDoc(docId) &&
                   ((request.auth.uid == userId && (isAdmin() || isApproved(userId))) || isAdmin());
      allow delete: if request.auth != null &&
                   ((request.auth.uid == userId && (isAdmin() || isApproved(userId))) || isAdmin());
    }
    // The (mostly unused) parent user doc — same admin-or-self rule, so the
    // best-effort `db.collection('users').doc(uid).delete()` cleanup call
    // succeeds instead of silently no-op'ing under default-deny.
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
