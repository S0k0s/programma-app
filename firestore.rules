rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'sokratispoun@gmail.com';
    }
    function isApproved(uid) {
      return exists(/databases/$(database)/documents/access/$(uid)) &&
             get(/databases/$(database)/documents/access/$(uid)).data.status == 'approved';
    }

    // Access records: sign-up is open — a signed-in user creates their own
    // record as 'approved' immediately (no manual admin gate). Only the
    // admin can change status afterwards (e.g. set 'denied' to revoke a
    // specific account), read anyone else's record, or list all records.
    match /access/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid &&
                    request.resource.data.status == 'approved';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Per-user app data: locked to the owning uid AND requires an approved
    // access request (the admin's own uid is always allowed).
    match /users/{userId}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId &&
                          (isAdmin() || isApproved(userId));
    }
  }
}
